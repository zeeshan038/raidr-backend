# Copy to .env on the server (one file per deploy folder — do not copy prod → dev).
#
# --- ~/raidr-backend-prod (docker compose up, port 5001) ---
# DATABASE_URL="postgresql://raidr_user:raidr_password@postgres:5432/raidr_prod?schema=public"
#
# --- ~/raidr-backend + docker-compose.dev.yml (port 5002) ---
# DATABASE_URL="postgresql://raidr_user:raidr_password@postgres:5432/raidr_db?schema=public"
#
# --- Local npm run (no Docker) — remote DB example ---
# DATABASE_URL="postgresql://raidr_user:raidr_password@188.245.72.1:5433/raidr_db?schema=public"
#
# Do NOT use @188.245.72.1:5432 in Docker compose .env unless you mean prod Postgres on the host.
# REDIS_URL is overridden to redis://redis:6379 by compose when using Docker.

PORT=5001
